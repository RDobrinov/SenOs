menu "DS18x20 Sensor Configuration"
    choice SENOS_DS18X20_RESOLUTION
        prompt "DS18X20 Default Resolution"
        default SENOS_DS18X20_RESOLUTION_12
        help
            "Select defaul sensor resolution"
        config SENOS_DS18X20_RESOLUTION_9
            bool "9 bit resolution ( 0.5°C )"
        config SENOS_DS18X20_RESOLUTION_10
            bool "9 bit resolution ( 0.25°C )"
        config SENOS_DS18X20_RESOLUTION_11
            bool "9 bit resolution ( 0.125°C )"
        config SENOS_DS18X20_RESOLUTION_12
            bool "9 bit resolution ( 0.0625°C )"
    endchoice
    config SENOS_DS18X20_RESOLUTION
        int
        default 0 if SENOS_DS18X20_RESOLUTION_9
        default 1 if SENOS_DS18X20_RESOLUTION_10
        default 2 if SENOS_DS18X20_RESOLUTION_11
        default 3 if SENOS_DS18X20_RESOLUTION_12

    config SENOS_DS18X20_DECIMALS
    int "Default decimal places"
    range 0 4
    default 2
    help
        Default decimals for measured temperature
    
    config SENOS_DS18X20_IIRFILTER
        bool "Activate internal IIR Filter"
        help
            Enable or disable internal driver IIR Filter
        default n
    
endmenu
